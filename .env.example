# Environment variables for MÈWOS storefront backend
# Copy this file to `.env` and fill the values before running locally or in production.

# Server
PORT=3000
NODE_ENV=production

# Order persistence. Production must use Firestore.
ORDER_STORAGE=firestore
# Provide either FIREBASE_SERVICE_ACCOUNT_JSON or application default credentials.
# Keep this value only in the hosting provider's secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Dropshipping / Supplier settings
# Use `mock` only for local development. Production must use a real provider.
DROPSHIPPING_PROVIDER=cj
DROPSHIPPING_API_URL=
DROPSHIPPING_API_KEY=
DROPSHIPPING_API_SECRET=

# If using CJ's Open Platform, the backend will attempt to fetch an
# access token using `DROPSHIPPING_API_KEY`. Provide the base URL for the
# provider's API in `DROPSHIPPING_API_URL`.

# Firebase (optional - frontend web config is normally safe to expose, but
# you can choose to inject the following at runtime via index.html):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Razorpay online payments. Keep the secret only on the backend host.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Important: Never commit a production `.env` file. Keep secrets out of
# version control and use CI/CD secret management or your hosting provider's
# environment variables feature.
